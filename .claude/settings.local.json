{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"/Users/shushinde/.local/bin/scout\" hook subagent",
            "type": "command"
          }
        ],
        "matcher": "Task|Agent"
      },
      {
        "hooks": [
          {
            "command": "\"/Users/shushinde/.local/bin/scout\" hook bash-compress || echo {}",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/Users/shushinde/.local/bin/scout\" hook session --host claude",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"/Users/shushinde/.local/bin/scout\" hook reflect",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": []
  },
  "permissions": {
    "allow": [
      "mcp__scout__search",
      "mcp__scout__semantic_doc_search",
      "mcp__scout__keyword_search",
      "mcp__scout__regex_search",
      "mcp__scout__go_to_definition",
      "mcp__scout__find_references",
      "mcp__scout__call_graph",
      "mcp__scout__impact",
      "mcp__scout__deep_search",
      "mcp__scout__file_outline",
      "mcp__scout__explain_symbol",
      "mcp__scout__top_symbols",
      "mcp__scout__list_repositories",
      "mcp__scout__investigate",
      "mcp__scout__investigate_expand",
      "mcp__scout__investigate_hydrate",
      "mcp__scout__changes_detect",
      "mcp__scout__changes_affected_tests",
      "mcp__scout__list_flows",
      "mcp__scout__affected_flows",
      "mcp__scout__architecture_overview",
      "mcp__scout__dead_code",
      "mcp__scout__file_read",
      "mcp__scout__memory_search",
      "mcp__scout__memory_read",
      "mcp__scout__memory_list",
      "mcp__scout__memory_related",
